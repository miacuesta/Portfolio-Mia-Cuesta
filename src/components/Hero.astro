---
import { Image } from "astro:assets";
import retrato from "../assets/img/retrato.png";

const cv = `${import.meta.env.BASE_URL}/cv.pdf`.replace("//", "/");
---

<section class="hero" id="inicio">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow">Backend · Datos · Patín artístico</p>
      <h1 class="hero__name">
        <span class="line"><span class="line__inner">Mía</span></span>
        <span class="line"><span class="line__inner">Cuesta</span></span>
        <span class="line"><span class="line__inner serif accent-blue barizom">Barizom</span></span>
      </h1>
      <p class="hero__lead reveal">
        Hago backend: me gustan los datos, el<br class="br-desk" /> análisis y los números.<br />
        Patino en River Plate desde los ocho años.
      </p>
      <div class="hero__ctas">
        <a href="#proyectos" class="btn btn--dark">Ver proyectos <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href={cv} target="_blank" rel="noopener" class="btn btn--outline">Ver CV <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="hero__next reveal">
        <span class="eyebrow">Próximo paso</span>
        <span>Ingeniería en Biotecnología <span class="dot-sep">·</span> ITBA</span>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__photo">
        <Image
          src={retrato}
          alt="Retrato de Mía Cuesta"
          widths={[400, 600]}
          sizes="(max-width: 900px) 90vw, 600px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <a href="#proyectos" class="seal" aria-label="Ir a proyectos">
        <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <path id="sealPath" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0"></path>
          </defs>
          <text>
            <textPath href="#sealPath" textLength="462">BACKEND · DATOS · PATÍN · BIOTECNOLOGÍA ·</textPath>
          </text>
        </svg>
        <span class="seal__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
